# ============================================================
# FinSight AI — Production Environment Template
# Copy to .env.prod and fill in ALL required values before
# running: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================================

# --- App ---
ENV=production

# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# --- Database ---
# Use Supabase hosted Postgres (recommended) or your own Postgres server.
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://finsight:CHANGE_ME@db:5432/finsight

# --- CORS (JSON list of allowed frontend origins) ---
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# --- Your deployment domain (used by nginx and certbot) ---
DOMAIN=yourdomain.com

# --- LLM Providers (configure at least one for the AI Advisor) ---
# Priority order: gemini > openai > openrouter > ollama (local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter is configured and works out-of-the-box with the free tier:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Ollama (self-hosted, runs in Docker with --profile local-llm):
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# --- n8n Automation (optional) ---
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# --- Supabase (optional production storage for documents) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=financial-documents

# --- Let's Encrypt TLS (uncomment certbot service in docker-compose.prod.yml) ---
# CERTBOT_EMAIL=admin@yourdomain.com
