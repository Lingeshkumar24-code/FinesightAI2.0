# Copy to .env and fill in what you have. Every value has a safe
# default or degrades gracefully if left blank (see app/config.py).

# --- App ---
ENV=development
JWT_SECRET=dev-secret-change-me
ALLOW_DEMO_AUTH=true

# --- Database ---
# Local/dev default (no setup needed): sqlite+aiosqlite:///./finsight.db
# Production (Supabase): postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./finsight.db

# --- Supabase (production) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=financial-documents

# --- LLM providers (model-agnostic router; leave any blank to skip it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Comma-separated priority order for LLM provider fallback chain
LLM_PROVIDER_PRIORITY=["gemini","openai","openrouter","ollama"]

# --- n8n ---
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# --- Market data (Twelve Data: benchmark quotes, ticker search, outlook) ---
# Free plan: 8 credits/minute and 800/day, one credit per symbol; the
# usage check itself costs one credit. Leave the key blank to disable the
# benchmark cards (the NSE page still works via Yahoo/yfinance).
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com
MARKET_WATCHLIST=SPY,QQQ,TLT,GLD,BTC/USD
MARKET_MAX_SYMBOLS=6

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
