{
  "name": "FinSight AI - Budget & Risk Monitoring (Scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "name": "Daily 7:00 AM Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "path": "finsight/run-monitoring",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "name": "Manual Monitoring Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "5d2c9a71-6b3e-4c8a-8f21-7e4b1c9d3a52",
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "={{$env.FINSIGHT_API_BASE_URL || 'http://127.0.0.1:8000/api/v1'}}/financials/budget-variance",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.FINSIGHT_SERVICE_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"period\": \"2026-Q3\",\n  \"budget\": {\"marketing\": 70000, \"engineering\": 125000, \"operations\": 45000, \"legal\": 15000, \"facilities\": 20000},\n  \"actual\": {\"marketing\": 85000, \"engineering\": 120000, \"operations\": 44200, \"legal\": 15000, \"facilities\": 21500},\n  \"breach_threshold_pct\": 10.0\n}"
      },
      "name": "Evaluate Budget Variance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [260, 100]
    },
    {
      "parameters": {
        "url": "={{$env.FINSIGHT_API_BASE_URL || 'http://127.0.0.1:8000/api/v1'}}/financials/risk",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.FINSIGHT_SERVICE_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"current_ratio\": 2.35,\n  \"debt_to_equity\": 0.54,\n  \"net_margin_pct\": 18.7,\n  \"cash_runway_months\": 7.0,\n  \"revenue_mom_change_pct\": 2.5\n}"
      },
      "name": "Evaluate Risk Detection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "breach_check",
              "leftValue": "={{$node[\"Evaluate Budget Variance\"].json.breaches.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "name": "Check Breaches or Risk",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 100]
    },
    {
      "parameters": {
        "url": "={{$env.FINSIGHT_API_BASE_URL || 'http://127.0.0.1:8000/api/v1'}}/alerts/webhook",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-N8N-Secret", "value": "={{$env.N8N_SHARED_SECRET || 'finsight-n8n-secret'}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ business_id: 'demo-business-001', title: 'n8n Alert: Budget Overspend Detected in ' + $node['Evaluate Budget Variance'].json.breaches.join(', '), message: 'Automated scheduled scan identified budget breaches. Total actual spend was ₹' + Number($node['Evaluate Budget Variance'].json.total_actual).toLocaleString('en-IN') + ' vs ₹' + Number($node['Evaluate Budget Variance'].json.total_budgeted).toLocaleString('en-IN') + ' budgeted. Overall risk: ' + ($node['Evaluate Risk Detection'].json.overall_level || 'unknown') + '.', severity: 'critical', source: 'n8n_automation' }) }}"
      },
      "name": "Dispatch Alert to FinSight API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [940, 0]
    }
  ],
  "connections": {
    "Daily 7:00 AM Schedule": {
      "main": [
        [{ "node": "Evaluate Budget Variance", "type": "main", "index": 0 }]
      ]
    },
    "Manual Monitoring Webhook Trigger": {
      "main": [
        [{ "node": "Evaluate Budget Variance", "type": "main", "index": 0 }]
      ]
    },
    "Evaluate Budget Variance": {
      "main": [
        [{ "node": "Evaluate Risk Detection", "type": "main", "index": 0 }]
      ]
    },
    "Evaluate Risk Detection": {
      "main": [
        [{ "node": "Check Breaches or Risk", "type": "main", "index": 0 }]
      ]
    },
    "Check Breaches or Risk": {
      "main": [
        [{ "node": "Dispatch Alert to FinSight API", "type": "main", "index": 0 }]
      ]
    }
  }
}
