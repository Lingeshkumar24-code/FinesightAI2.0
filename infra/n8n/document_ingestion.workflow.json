{
  "name": "FinSight AI - Document Ingestion (on Upload)",
  "nodes": [
    {
      "parameters": {
        "path": "finsight/storage-webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "name": "Supabase Storage Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "2b7e4c19-8d3f-4a5b-b6c8-9e1f3a7d2c60",
      "position": [0, 0],
      "notes": "Configured as a Supabase Storage 'object created' event target for the financial-documents bucket."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"record\"][\"name\"].split('.').pop().toLowerCase()}}",
              "operation": "regex",
              "value2": "pdf|xlsx|xls"
            }
          ]
        }
      },
      "name": "Is Binary Format?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "download",
        "bucketName": "financial-documents",
        "fileKey": "={{$json[\"record\"][\"name\"]}}"
      },
      "name": "Download From Storage",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [440, -80],
      "notes": "Only on the 'true' branch (binary formats). Text files skip straight to the API call."
    },
    {
      "parameters": {
        "operation": "pdf"
      },
      "name": "Extract Text (PDF/XLSX)",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [660, -80]
    },
    {
      "parameters": {
        "url": "={{$env.FINSIGHT_API_BASE_URL}}/documents/upload",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.FINSIGHT_SERVICE_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "file", "value": "={{$binary.data}}" }
          ]
        }
      },
      "name": "POST /documents/upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "documents",
        "updateKey": "id",
        "columns": "status"
      },
      "name": "Mark Document Processed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "fromEmail": "alerts@finsight.ai",
        "toEmail": "={{$json[\"business_owner_email\"]}}",
        "subject": "Your document is ready",
        "text": "={{$json[\"source\"]}} has been indexed ({{$json[\"chunks_indexed\"]}} chunks) and is now searchable by the AI Advisor."
      },
      "name": "Notify Owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Supabase Storage Webhook": { "main": [[{ "node": "Is Binary Format?", "type": "main", "index": 0 }]] },
    "Is Binary Format?": {
      "main": [
        [{ "node": "Download From Storage", "type": "main", "index": 0 }],
        [{ "node": "POST /documents/upload", "type": "main", "index": 0 }]
      ]
    },
    "Download From Storage": { "main": [[{ "node": "Extract Text (PDF/XLSX)", "type": "main", "index": 0 }]] },
    "Extract Text (PDF/XLSX)": { "main": [[{ "node": "POST /documents/upload", "type": "main", "index": 0 }]] },
    "POST /documents/upload": { "main": [[{ "node": "Mark Document Processed", "type": "main", "index": 0 }]] },
    "Mark Document Processed": { "main": [[{ "node": "Notify Owner", "type": "main", "index": 0 }]] }
  }
}
